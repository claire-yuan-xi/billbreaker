# Gemini key for the plain-language analysis (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Used when the main model is out of free quota or overloaded
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Optional: state bill text from Open States
OPENSTATES_API_KEY=
# Local SQLite file for the cache, share links and rate limits
DATABASE_PATH=data/billbreaker.db
# Hosted Turso database (set on Vercel; leave empty locally)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Set to 1 to back saved bills up on the server
CLOUD_SYNC=0
# Abuse monitoring (/admin/abuse)
ABUSE_ADMIN_TOKEN=
ABUSE_ALERT_WEBHOOK_URL=
